# ===================================================================
# LEADS HARVESTER & CRM B2B - CONFIGURAÇÃO DE AMBIENTE (ONLINE / LOCAL)
# ===================================================================

# Porta do Servidor Web (detectada automaticamente em provedores de nuvem como Render, Railway, Fly.io)
PORT=8000

# Chave secreta de sessão / cookies (troque por uma chave aleatória e segura quando subir online)
SECRET_KEY=b2b_secret_session_key_production_leads_app_2026

# Modo de Autenticação Obrigatória:
#   true  = Exige login e senha para acessar qualquer tela (ideal para modo online compartilhado por 2 operadores)
#   false = Permite alternar operadores livremente (ideal para testes locais)
AUTH_REQUIRED=false

# ===================================================================
# CONTAS DE ACESSO INICIAIS (SEED AUTOMÁTICO DO BANCO)
# ===================================================================
# Operador 1: operador1 / senha123
# Operador 2: operador2 / senha123
# Administrador / Gerente: admin / Akali
# (As senhas e nomes podem ser alterados diretamente no Portal do Gerente /admin)

# ===================================================================
# INTEGRAÇÃO WHATSAPP (WAHA - WhatsApp HTTP API)
# ===================================================================
# URL do container WAHA ou servidor dedicado WhatsApp
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=2b5d16deb67241efa1cffa371e1f354b
WAHA_MIN_DELAY=15
WAHA_MAX_DELAY=35

# ===================================================================
# APIS EXTERNAS OPCIONAIS (SCRAPER)
# ===================================================================
# Google Places API Key (opcional - o sistema já conta com Web Scraping nativo sem custo)
GOOGLE_PLACES_API_KEY=

# Apify Token (opcional - para importações remotas massivas)
APIFY_TOKEN=
